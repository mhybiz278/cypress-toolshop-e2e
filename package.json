{
  "name": "cypress-toolshop-e2e",
  "version": "1.0.0",
  "description": "Cypress end-to-end automation framework for the Toolshop (Practice Software Testing) demo application \u2014 Page Object Model, service layer, API seeding, CI-ready.",
  "author": "Mhyli Jade C. Bizares",
  "license": "MIT",
  "private": true,
  "scripts": {
    "app:up": "bash scripts/start-app.sh",
    "app:seed": "docker compose exec -T laravel-api php artisan migrate:fresh --seed --force",
    "app:down": "docker compose down -v",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "cypress run",
    "test:smoke": "cypress run --expose grepTags=@smoke",
    "test:regression": "cypress run --expose grepTags=@regression",
    "test:api": "cypress run --spec 'cypress/e2e/api/**/*.cy.js'",
    "test:ui": "cypress run --spec 'cypress/e2e/!(api)/**/*.cy.js'",
    "test:a11y": "cypress run --spec 'cypress/e2e/accessibility/**/*.cy.js'",
    "test:headed": "cypress run --headed --no-exit",
    "summary": "node scripts/ci-summary.js",
    "report:merge": "mochawesome-merge cypress/reports/.jsons/*.json > cypress/reports/merged.json",
    "report:generate": "marge cypress/reports/merged.json -f report -o cypress/reports/html",
    "report": "npm run report:merge && npm run report:generate",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@cypress/grep": "^6.0.3",
    "@faker-js/faker": "^9.0.3",
    "axe-core": "^4.13.0",
    "cypress": "^15.21.0",
    "cypress-axe": "^1.7.0",
    "cypress-mochawesome-reporter": "^3.8.2",
    "eslint": "^8.57.0",
    "eslint-plugin-cypress": "^3.4.0",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
